+// One transient mask per HTTP request, shared by its parent and children.
+static std::shared_ptr<const std::vector<llama_logit_bias>> make_token_prefix_bias(
+        const llama_vocab * vocab, const std::vector<unsigned char> & prefix) {
+    if (prefix.empty()) {
+        return nullptr;
+    }
+    auto bias = std::make_shared<std::vector<llama_logit_bias>>();
+    const int n_vocab = llama_vocab_n_tokens(vocab);
+    bias->reserve(n_vocab);
+    std::vector<char> piece(128);
+    int matching = 0;
+    for (llama_token token = 0; token < n_vocab; ++token) {
+        int count = 0;
+        if (!llama_vocab_is_control(vocab, token)) {
+            count = llama_token_to_piece(vocab, token, piece.data(), piece.size(), 0, false);
+            if (count < 0) {
+                piece.resize(-count);
+                count = llama_token_to_piece(vocab, token, piece.data(), piece.size(), 0, false);
+            }
+        }
+        const bool match = count > 0 && std::equal(piece.begin(),
+            piece.begin() + std::min(static_cast<size_t>(count), prefix.size()), prefix.begin(),
+            [](char a, unsigned char b) { return static_cast<unsigned char>(a) == b; });
+        if (match) ++matching;
+        else bias->push_back({token, -INFINITY});
+    }
+    if (matching == 0) throw std::runtime_error("token_prefix has no vocabulary continuation");
+    return bias;
+}
